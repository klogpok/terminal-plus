{
  "name": "devpanel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "start": "pnpm --filter @devpanel/server start",
    "desktop": "pnpm --filter @devpanel/web build && pnpm --filter @devpanel/desktop start",
    "desktop:check": "cargo check --manifest-path packages/desktop/src-tauri/Cargo.toml --all-targets && cargo clippy --manifest-path packages/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings",
    "desktop:electron": "pnpm --filter @devpanel/desktop start:electron",
    "desktop:dist": "pnpm build && pnpm --filter @devpanel/desktop dist",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
